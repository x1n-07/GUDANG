generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String
  name      String
  companyId String?
  contact   String?
  disabled  Boolean  @default(false)
  company   Company? @relation(fields: [companyId], references: [id])
}

model Company {
  id                String             @id @default(uuid())
  name              String
  disabled          Boolean            @default(false)

  // Relations
  users             User[]
  technicians       Technician[]
  goods             GoodsItem[]
  goodsTransactions GoodsTransaction[]
  equipment         EquipmentItem[]
  equipmentLogs     EquipmentLog[]
  vehicles          VehicleItem[]
  vehicleLogs       VehicleLog[]
  vehicleNeeds      VehicleNeed[]
}

model ActivityLog {
  id          String      @id @default(uuid())
  adminId     String
  companyId   String?
  username    String
  action      String      // 'LOGIN' | 'CREATE' | 'UPDATE' | 'DELETE' | 'LOGOUT'
  entity      String      // 'GOODS' | 'EQUIPMENT' | 'VEHICLE' | 'USER' | 'COMPANY' | 'TECHNICIAN' | 'TRANSACTION'
  description String
  date        DateTime    @default(now())
}

model Technician {
  id        String  @id @default(uuid())
  adminId   String
  companyId String
  name      String
  role      String
  phone     String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model GoodsItem {
  id           String             @id @default(uuid())
  adminId      String
  companyId    String
  name         String
  category     String
  stock        Float
  minStock     Float
  unit         String
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions GoodsTransaction[]
}

model GoodsTransaction {
  id        String    @id @default(uuid())
  adminId   String
  companyId String
  itemId    String
  type      String
  quantity  Float
  date      DateTime  @default(now())
  notes     String
  pic       String?
  item      GoodsItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model EquipmentItem {
  id          String         @id @default(uuid())
  adminId     String
  companyId   String
  name        String
  condition   String
  status      String
  currentUser String?
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  logs        EquipmentLog[]
}

model EquipmentLog {
  id          String        @id @default(uuid())
  adminId     String
  companyId   String
  equipmentId String
  user        String
  action      String
  date        DateTime      @default(now())
  condition   String
  notes       String
  equipment   EquipmentItem @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model VehicleItem {
  id                    String        @id @default(uuid())
  adminId               String
  companyId             String
  plateNumber           String
  name                  String
  status                String
  odometer              Float         @default(0)
  lastOilChangeOdometer Float         @default(0)
  oilChangeInterval     Float         @default(5000)
  lastServiceOdometer   Float         @default(0)
  serviceInterval       Float         @default(10000)
  company               Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  logs                  VehicleLog[]
  needs                 VehicleNeed[]
}

model VehicleLog {
  id            String      @id @default(uuid())
  adminId       String
  companyId     String
  vehicleId     String
  driver        String
  purpose       String
  startDate     DateTime    @default(now())
  endDate       DateTime?
  status        String
  endOdometer   Float?
  startOdometer Float?
  vehicle       VehicleItem @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model VehicleNeed {
  id          String      @id @default(uuid())
  adminId     String
  companyId   String
  vehicleId   String
  type        String
  description String
  cost        Float
  date        DateTime    @default(now())
  pic         String
  vehicle     VehicleItem @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
}
